# Email credentials (used by the smtp backend and as the SendGrid From sender)
# For Gmail SMTP, create an App Password instead of using your account password:
# https://support.google.com/accounts/answer/185833
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# SMTP settings (smtp backend only)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Display name shown in the From header
SENDER_NAME=Your Name

# Campaign to send: welcome, invoice, certificate, newsletter
EMAIL_TYPE=welcome

# Recipients CSV file (must have Name and Email columns;
# never commit real recipient data to git)
RECIPIENTS_FILE=recipients.csv

# ==========================================
# Delivery backend (ESP architecture)
# ==========================================
# smtp = classic SMTP/STARTTLS (personal/small lists only)
# gmail = Gmail API with OAuth2 (bounce sync included)
# sendgrid = SendGrid v3 REST API (bulk-safe, bounce sync included)
# ses = Amazon SES v2 API (bulk-safe, suppression sync included)
DELIVERY_BACKEND=smtp

# --- SendGrid backend (https://app.sendgrid.com/settings/api_keys) ---
# Also verify EMAIL_ADDRESS as a sender in SendGrid.
# Requires: pip install requests
SENDGRID_API_KEY=

# --- Gmail API backend ---
# Download the OAuth client from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID, type "Desktop app").
# The first run opens a browser; the token is then cached in
# GMAIL_TOKEN_FILE for scheduled runs.
# Requires: pip install google-auth google-auth-oauthlib google-api-python-client
GMAIL_CREDENTIALS_FILE=client_secret.json
GMAIL_TOKEN_FILE=gmail_token.json

# --- Amazon SES backend (FromEmailAddress must be a verified identity) ---
# AWS credentials come from the standard boto3 chain (env vars, AWS
# profile, or instance role). SES sandbox mode requires verified
# recipient addresses too — request production access first.
# Requires: pip install boto3
AWS_REGION=us-east-1
SES_FROM_ADDRESS=

# ==========================================
# Unsubscribe + suppression (CAN-SPAM / GDPR)
# ==========================================
# HMAC secret for unsubscribe tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
UNSUBSCRIBE_SECRET=

# HTTPS endpoint of the unsubscribe app (deploy unsubscribe_server.py,
# e.g. on Render/Railway). Enables one-click unsubscribe in Gmail.
UNSUBSCRIBE_BASE_URL=

# mailto: fallback that works without hosting a server.
UNSUBSCRIBE_MAILTO=

# Addresses on this list are never emailed (bounces, complaints,
# unsubscribes). Gitignored on purpose.
SUPPRESSION_FILE=suppression.csv
