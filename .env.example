# Email credentials
# For Gmail, create an App Password instead of using your account password:
# https://support.google.com/accounts/answer/185833
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# SMTP settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Display name shown in the From header
SENDER_NAME=Your Name

# Campaign to send: welcome, invoice, certificate, newsletter
EMAIL_TYPE=welcome

# Recipients CSV file (must have Name and Email columns;
# never commit real recipient data to git)
RECIPIENTS_FILE=recipients.csv
